rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Yardımcı fonksiyonlar
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 1. Üye Profilleri Koleksiyonu (users)
    match /users/{userId} {
      // Giriş yapmış tüm üyeler kulüp üyelerini görüntüleyebilir
      allow read: if isAuthenticated();
      
      // Yeni kaydolan kullanıcı kendi dokümanını oluşturabilir
      allow create: if isAuthenticated();
      
      // Kullanıcı profilini veya admin yetkisine sahip kullanıcı rol/yetki düzenleyebilir
      allow update: if isAuthenticated();
      
      // Kullanıcı kendi hesabını veya yetkili hesapları silebilir
      allow delete: if isAuthenticated();
    }

    // 2. Öğrenci Numarası Tekillik İndeksi (studentNumbers)
    // Giriş yaparken öğrenci numarasından e-posta adresini sorgulayabilmek için
    // oturum açmamış kullanıcılara da okuma izni verilir.
    // Bu koleksiyon yalnızca { uid, email, createdAt } eşleşmesini tutar.
    match /studentNumbers/{studentNo} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // 3. Etkinlikler ve Katılımcılar (events)
    match /events/{eventId} {
      // Tüm kulüp üyeleri ve ziyaretçiler etkinlikleri görebilir
      allow read: if true;
      
      // Katılımcı ekleme/çıkarma veya admin etkinlik yönetimi
      allow write: if isAuthenticated();
    }

    // 4. Kulüp Duyuruları (announcements)
    match /announcements/{announcementId} {
      // Duyuruları herkes okuyabilir
      allow read: if true;
      
      // Sadece giriş yapmış yetkili kulüp üyeleri duyuru ekleyebilir
      allow write: if isAuthenticated();
    }

    // 5. Admin Listesi ve Yetki Tanımları (admins)
    // Yetkili yönetici hesaplarının gerçek zamanlı doğrulanması ve yönetimi
    match /admins/{adminId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
  }
}

